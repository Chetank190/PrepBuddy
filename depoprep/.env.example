# Next.js (local dev). `npx convex dev` writes these into .env.local for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# AI keys do NOT go here. The grader runs in Convex and reads Convex's env store:
#   npx convex env set GEMINI_API_KEY <key>      # main grader + embeddings (free, aistudio.google.com)
#   npx convex env set GROQ_API_KEY <key>        # fallback grader (free, console.groq.com)
#   npx convex env set ANTHROPIC_API_KEY <key>   # optional last resort (paid)
# Optional: GEMINI_MODEL, GROQ_MODEL, GRADER_RAG (auto | prompt | display | off)

# Vercel only: Project Settings → Environment Variables
#   CONVEX_DEPLOY_KEY=<production deploy key from the Convex dashboard>
